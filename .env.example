# ===== Telegram =====
BOT_TOKEN=your_bot_token_here

# ===== Admin (comma separated Telegram user IDs) =====
ADMIN_IDS=123456789

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://uytop:uytop@localhost:5432/uytop

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Runtime mode: polling | webhook =====
MODE=polling
LOG_LEVEL=INFO

# ===== Webhook (only used when MODE=webhook) =====
WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET=uytop-secret

# ===== Listing rules =====
LISTING_TTL_DAYS=30
EXPIRY_REMINDER_DAYS=3
MIN_LISTING_IMAGES=3
MAX_LISTING_IMAGES=15
MAX_ACTIVE_LISTINGS_PER_USER=20
RATE_LIMIT_SECONDS=1
